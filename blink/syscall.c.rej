+
+/* G12: node/libuv calls capget during bootstrap; ENOSYS made the caller spin
+ * forever (getpid→capget→getuid×4 loop). Return success with no capabilities:
+ * user_cap_hdr version 1 (LINUX_CAPABILITY_VERSION_1), 0 effective/inheritable
+ * caps, all 1 permitted bits cleared. */
+static int SysCapget(struct Machine *m, i64 hdraddr, i64 dataaddr) {
+  u8 *hdr;
+  if (!hdraddr)
+    return 0;
+  if (!(hdr = (u8 *)SchlepW(m, hdraddr, 8)))
+    return efault();
+  /* Accept any version the guest asks for; report V1 and zero caps.
+   * Real Linux versions are 0x19980330/V1, 0x19980331/V2, 0x20071026/V3 —
+   * our earlier check `version>1` rejected them all as EINVAL, leaving the
+   * caller spinning. */
+  /* Linux capability versions: V1=0x19980330, V2=0x19980331, V3=0x20071026.
+   * Echo back the requested version so the caller doesn't retry. */
+  u32 req_version = Read32(hdr);
+  Write32(hdr, req_version);
+  Write32(hdr + 4, 0);
+  if (dataaddr) {
+    u8 *data;
+    if (!(data = (u8 *)SchlepW(m, dataaddr, 12)))
+      return efault();
+    memset(data, 0, 12); /* effective, permitted, inheritable */
+  }
+  return 0;
+}
