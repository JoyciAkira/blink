+/* G12 terminal process-group shutdown: record the authoritative group exit
+ * code exactly once. Every downstream exit path (group exit, thread exit,
+ * benign signal teardown) must consult this record so the OUTER process
+ * reports the guest leader's code (0 for G12) instead of a teardown
+ * SIGABRT/SIGKILL. On wasm one outer process hosts the whole group. */
+static int G12RecordGroupExit(struct Machine *m, int rc) {
+  struct System *s = m->system;
+  bool first = false;
+  if (!atomic_load_explicit(&s->group_exiting, memory_order_acquire)) {
+    if (!atomic_exchange_explicit(&s->group_exiting, true, memory_order_acq_rel)) {
+      s->exited = true;
+      s->exitcode = rc;
+      first = true;
+    }
+  }
+  return s->exitcode;
+}
